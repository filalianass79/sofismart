# ——— SOFISMART — PRODUCTION AWS ———
# Copier vers .env.production sur le serveur / Secrets Manager ECS
# NE JAMAIS réutiliser les secrets staging

APP_ENV=production
APP_NAME=SOFISMART
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=SOFISMART

NODE_ENV=production

# Domaine public HTTPS (ALB + ACM ou CloudFront)
APP_URL="https://app.sofismart.com"
NEXTAUTH_URL="https://app.sofismart.com"

# openssl rand -base64 32
AUTH_SECRET=

# ——— Amazon RDS PostgreSQL ———
# Format : postgresql://USER:PASSWORD@endpoint.rds.amazonaws.com:5432/sofismart?schema=public&sslmode=require
DATABASE_URL=

# ——— Stockage S3 (recommandé AWS) ———
UPLOAD_STORAGE=s3
AWS_REGION=eu-west-3
AWS_S3_REGION=eu-west-3
AWS_S3_BUCKET=sofismart-prod-uploads
AWS_S3_PREFIX=uploads
# CloudFront ou domaine CDN devant le bucket
AWS_S3_PUBLIC_BASE_URL=https://cdn.sofismart.com
# Sur ECS : utiliser un rôle IAM task (laisser vides les clés ci-dessous)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

MAX_UPLOAD_BYTES=10485760

ENABLE_DEBUG_MODE=false
ENABLE_MOCK_NOTIFICATIONS=false

# Migrations au démarrage conteneur (premier déploiement uniquement, puis false)
RUN_MIGRATIONS_ON_START=false
RUN_SEED_ON_START=false

SEED_MODE=production
SEED_ADMIN_EMAIL=admin@sofismart.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrateur SOFISMART

# ——— E-mail (Amazon SES SMTP ou fournisseur externe) ———
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_TEST_MODE=false
EMAIL_LOG_ONLY=false

# Amazon SES SMTP (région eu-west-3)
# SMTP_HOST=email-smtp.eu-west-3.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SOFISMART
SMTP_FROM_EMAIL=contact@sofismart.com
SMTP_REPLY_TO=contact@sofismart.com

# ——— WhatsApp ———
WHATSAPP_ENABLED=false
WHATSAPP_TEST_MODE=false

# QR tokens (openssl rand -hex 32)
# QR_SECRET=
