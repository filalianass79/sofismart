  @@index([invoiceImportId])
}

// ——— Vente ———

model Sale {
  id                    String             @id @default(cuid())
  reference             String             @unique @default("VTE-LEGACY")
  vehicleId             String             @unique
  vehicle               Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  clientId              String?
  client                Client?            @relation(fields: [clientId], references: [id])
  depotId               String?
  depot                 Depot?             @relation("SaleDepot", fields: [depotId], references: [id])
  commercialId          String?
  commercial            User?              @relation("SaleCommercial", fields: [commercialId], references: [id], onDelete: SetNull)
  validatedById         String?
  validatedBy           User?              @relation("SaleValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt           DateTime?
  saleDate              DateTime
  price                 Decimal            @db.Decimal(14, 2)
  discount              Decimal            @default(0) @db.Decimal(14, 2)
  taxAmount             Decimal            @default(0) @db.Decimal(14, 2)
  finalPrice            Decimal            @default(0) @db.Decimal(14, 2)
  costPrice             Decimal            @default(0) @db.Decimal(14, 2)
  margin                Decimal            @default(0) @db.Decimal(14, 2)
  marginRate            Decimal?           @db.Decimal(8, 4)
  advanceReceived       Decimal            @default(0) @db.Decimal(14, 2)
  saleType              SaleType           @default(CASH)
  paymentMethod         PaymentMethod?
  paymentStatus         SalePaymentStatus  @default(UNPAID)
  status                SaleRecordStatus   @default(VALIDATED)
  deliveryStatus        DeliveryStatus     @default(NOT_STARTED)
  warranty              Boolean            @default(false)
  warrantyDurationMonths Int?
  specialConditions     String?            @db.Text
  draftClient           Json?
  cancelReason          String?            @db.Text
  notes                 String?            @db.Text
  invoiceNumber         String?            @unique
  invoicePdfPath        String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  payments              Payment[]          @relation("SalePayments")
  documents             Document[]
  stockMovements        StockMovement[]    @relation("SaleMovements")
  exitVoucher           ExitVoucher?
  deliveryNote          DeliveryNote?
  deliveryDocuments     DeliveryDocument[]
  convertedFromProforma ProformaInvoice?

  @@index([status, saleDate])
  @@index([commercialId, status])
  @@index([clientId])
}

model ProformaInvoice {
  id                   String          @id @default(cuid())
  reference            String          @unique
  clientId             String?
  client               Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  temporaryClientData  Json?
  vehicleId            String
  vehicle              Vehicle         @relation(fields: [vehicleId], references: [id])
  commercialId         String
  commercial           User            @relation("ProformaCommercial", fields: [commercialId], references: [id], onDelete: Restrict)
  proformaDate         DateTime
  validityDate         DateTime
  priceHT              Decimal         @db.Decimal(14, 2)
  discount             Decimal         @default(0) @db.Decimal(14, 2)
  accessoryFees        Decimal         @default(0) @db.Decimal(14, 2)
  taxRate              Decimal         @default(20) @db.Decimal(5, 2)
  taxAmount            Decimal         @default(0) @db.Decimal(14, 2)
  totalTTC             Decimal         @default(0) @db.Decimal(14, 2)
  paymentTerms         String?         @db.Text
  observations         String?         @db.Text
  status               ProformaStatus  @default(DRAFT)
  pdfUrl               String?
  generatedAt          DateTime?
  printedAt            DateTime?
  sentAt               DateTime?
  convertedSaleId      String?         @unique
  convertedSale        Sale?           @relation(fields: [convertedSaleId], references: [id], onDelete: SetNull)
  createdById          String
  createdBy            User            @relation("ProformaCreator", fields: [createdById], references: [id], onDelete: Restrict)
