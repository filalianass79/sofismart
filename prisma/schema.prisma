  createdAt DateTime @default(now())
}

// ——— Mouvements de stock / transferts ———

model StockMovement {
  id            String              @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  movementType  StockMovementType   @default(INITIAL)
  status        StockMovementStatus @default(COMPLETED)
  fromDepotId   String?
  fromDepot     Depot?              @relation("FromDepot", fields: [fromDepotId], references: [id])
  toDepotId     String?
  toDepot       Depot?              @relation("ToDepot", fields: [toDepotId], references: [id])
  purchaseId    String?
  purchase      Purchase?           @relation("PurchaseMovements", fields: [purchaseId], references: [id], onDelete: SetNull)
  saleId        String?
  sale          Sale?               @relation("SaleMovements", fields: [saleId], references: [id], onDelete: SetNull)
  reason        String?
  movementDate  DateTime            @default(now())
  createdAt     DateTime            @default(now())
  completedAt   DateTime?
  userId        String?
  user          User?               @relation(fields: [userId], references: [id])
  completedById String?
}
