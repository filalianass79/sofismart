  history              ProformaHistory[]

  @@index([status, proformaDate])
  @@index([commercialId])
  @@index([clientId])
  @@index([vehicleId])
  @@index([validityDate])
}

model ProformaLine {
  id                String          @id @default(cuid())
  proformaInvoiceId String
  proformaInvoice   ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
  designation       String
  quantity          Decimal         @default(1) @db.Decimal(10, 2)
  unitPriceHT       Decimal         @db.Decimal(14, 2)
  discount          Decimal         @default(0) @db.Decimal(14, 2)
  taxRate           Decimal         @default(20) @db.Decimal(5, 2)
  taxAmount         Decimal         @default(0) @db.Decimal(14, 2)
  totalHT           Decimal         @default(0) @db.Decimal(14, 2)
  totalTTC          Decimal         @default(0) @db.Decimal(14, 2)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())

  @@index([proformaInvoiceId])
}

model ProformaHistory {
  id                String                 @id @default(cuid())
