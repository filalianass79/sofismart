// SOFISMART — schéma PostgreSQL (Prisma 7)
// Calculs métier (prix de revient, marge) appliqués dans les routes API

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

