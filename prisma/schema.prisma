// ——— NextAuth (comptes optionnels / extensibilité) ———

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ——— RH & accès ———

model Employee {
  id                String              @id @default(cuid())
  reference         String              @unique
  firstName         String
  lastName          String
  cin               String?             @unique
  personalEmail     String?
  professionalEmail String?             @unique
  phone             String?
  address           String?             @db.Text
  city              String?
  birthDate         DateTime?
  hireDate          DateTime?
  jobFunction       EmployeeJobFunction
  department        String?
  depotId           String?
  depot             Depot?              @relation(fields: [depotId], references: [id])
  contractType      String?
  salary            Decimal?            @db.Decimal(14, 2)
  status            EmployeeStatus      @default(ACTIVE)
  profilePhotoUrl   String?
  notes             String?             @db.Text
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User?
  documents         EmployeeDocument[]
}

model EmployeeDocument {
  id           String               @id @default(cuid())
  employeeId   String
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         EmployeeDocumentType @default(OTHER)
  title        String?
  fileName     String
  fileUrl      String
  fileMimeType String?
  fileSize     Int?
  uploadedById String?
  uploadedBy   User?                @relation("EmployeeDocUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime             @default(now())
}

model Role {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?          @db.Text
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(cuid())
  module          String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  allowed      Boolean    @default(true)

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  allowed      Boolean    @default(true)

  @@unique([userId, permissionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorUser   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  module      String
  targetType  String?
  targetId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([module, createdAt])
  @@index([actorUserId, createdAt])
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String    @unique
  ipAddress    String?
  userAgent    String?   @db.Text
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId])
}

// ——— Utilisateurs ———

model User {
  id                  String           @id @default(cuid())
  employeeId          String?          @unique
  employee            Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  username            String?          @unique
  email               String           @unique
  recoveryEmail       String?
  emailVerified       DateTime?
  name                String?
  image               String?
  passwordHash        String
  role                UserRole         @default(COMMERCIAL)
  roleId              String?
  appRole             Role?            @relation(fields: [roleId], references: [id])
  accountStatus       AccountStatus    @default(ACTIVE)
  passwordMustChange  Boolean          @default(false)
  temporaryPassword   Boolean          @default(false)
  twoFactorEnabled    Boolean          @default(false)
  lastLoginAt         DateTime?
  depotId             String?
  depot               Depot?           @relation(fields: [depotId], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  accounts            Account[]
  sessions            Session[]
  stockMovements      StockMovement[]
  documents           Document[]       @relation("UploadedBy")
  employeeDocuments   EmployeeDocument[] @relation("EmployeeDocUploader")
  userPermissions     UserPermission[]
  auditLogs           AuditLog[]       @relation("AuditActor")
  userSessions        UserSession[]    @relation("UserSessions")
  assignedClients     Client[]         @relation("ClientCommercial")
  clientInteractions  ClientInteraction[] @relation("InteractionEmployee")
  clientReminders     ClientReminder[] @relation("ReminderAssignee")
  clientDocuments     ClientDocument[] @relation("ClientDocUploader")
  managedDepots       Depot[]          @relation("DepotManager")
  commercialSales     Sale[]           @relation("SaleCommercial")
  validatedSales      Sale[]           @relation("SaleValidator")
  proformasCommercial ProformaInvoice[] @relation("ProformaCommercial")
  proformasCreated    ProformaInvoice[] @relation("ProformaCreator")
  proformaHistory     ProformaHistory[] @relation("ProformaHistoryActor")
  assignedExitVouchers ExitVoucher[]   @relation("ExitVoucherAssignee")
  deliveredExitVouchers ExitVoucher[]  @relation("ExitVoucherDeliverer")
  cancelledExitVouchers ExitVoucher[]  @relation("ExitVoucherCanceller")
  generatedDeliveryNotes DeliveryNote[] @relation("DeliveryNoteGenerator")
  deliveredDeliveryNotes DeliveryNote[] @relation("DeliveryNoteDeliverer")
  uploadedDeliveryDocuments DeliveryDocument[] @relation("DeliveryDocUploader")
  appNotifications           AppNotification[]
  notificationPreferences    UserNotificationPreference?
  whatsappMessagesReceived   WhatsAppMessage[]           @relation("WhatsAppRecipient")
  emailMessagesReceived      EmailMessage[]              @relation("EmailRecipient")
  userEmailPreference        UserEmailPreference?
  generatedDocuments  GeneratedDocument[]  @relation("GeneratedDocuments")
  documentHistoryActs DocumentHistory[]    @relation("DocumentHistoryActor")
  invoiceImports      InvoiceImport[]      @relation("InvoiceImportUploader")
}

// ——— Dépôts ———

model Depot {
  id           String      @id @default(cuid())
  reference    String      @unique @default("DEP-LEGACY")
  name         String
  address      String?     @db.Text
  city         String?
  phone        String?
  managerId    String?
  manager      User?       @relation("DepotManager", fields: [managerId], references: [id], onDelete: SetNull)
  maxCapacity  Int         @default(50)
  depotType    DepotType   @default(MAIN)
  status       DepotStatus @default(ACTIVE)
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  vehicles     Vehicle[]
  users        User[]
  employees    Employee[]
  movementsFrom StockMovement[] @relation("FromDepot")
  movementsTo   StockMovement[] @relation("ToDepot")
  sales         Sale[]          @relation("SaleDepot")
  exitVouchers  ExitVoucher[]
  deliveryNotes DeliveryNote[]
}

// ——— Fournisseurs & clients ———

model Supplier {
  id                     String               @id @default(cuid())
  reference              String               @unique @default("FRN-LEGACY")
  type                   SupplierType
  name                   String
  firstName              String?
  lastName               String?
  companyName            String?
  tradeName              String?
  ice                    String?              @unique
  cin                    String?              @unique
  rc                     String?
  taxId                  String?
  patent                 String?
  phone                  String?
  secondaryPhone         String?
  email                  String?
  address                String?              @db.Text
  city                   String?
  country                String?              @default("Maroc")
  contactName            String?
  contactRole            String?
  contactPhone           String?
  preferredPaymentMethod PaymentMethod?
  paymentDelay           Int?
  bankName               String?
  iban                   String?
  balance                Decimal              @default(0) @db.Decimal(14, 2)
  status                 SupplierRecordStatus @default(ACTIVE)
  notes                  String?              @db.Text
  isArchived             Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  purchases              Purchase[]
  documents              Document[]
  payments               Payment[]            @relation("SupplierPayments")
}

model Client {
  id                     String              @id @default(cuid())
  reference              String              @unique @default("CLI-LEGACY")
  type                   ClientType
  name                   String
  civility               Civility?
  firstName              String?
  lastName               String?
  companyName            String?
  tradeName              String?
  cin                    String?             @unique
  ice                    String?             @unique
  rc                     String?
  taxId                  String?
  patent                 String?
  activity               String?
  birthDate              DateTime?
  phone                  String?
  secondaryPhone         String?
  email                  String?
  website                String?
  address                String?             @db.Text
  city                   String?
  country                String?             @default("Maroc")
  profession             String?
  mainContactName        String?
  mainContactRole        String?
  mainContactPhone       String?
  mainContactEmail       String?
  assignedCommercialId   String?
  assignedCommercial     User?               @relation("ClientCommercial", fields: [assignedCommercialId], references: [id], onDelete: SetNull)
  acquisitionSource      AcquisitionSource?
  preferredPaymentMethod PaymentMethod?
  paymentTerms           String?
  paymentDelay           Int?
  bankName               String?
  iban                   String?
  creditLimit            Decimal?            @db.Decimal(14, 2)
  currentBalance         Decimal             @default(0) @db.Decimal(14, 2)
  outstandingAmount      Decimal             @default(0) @db.Decimal(14, 2)
  vatExempt              Boolean             @default(false)
  financialStatus        FinancialStatus     @default(GOOD_PAYER)
  relationshipStatus     RelationshipStatus  @default(PROSPECT)
  notes                  String?             @db.Text
  isArchived             Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  sales                  Sale[]
  proformas              ProformaInvoice[]
  documents              Document[]
  clientDocuments        ClientDocument[]
  interactions           ClientInteraction[]
  reminders              ClientReminder[]
  payments               Payment[]           @relation("ClientPayments")
  deliveryNotes          DeliveryNote[]
  deliveryDocuments      DeliveryDocument[]

  @@index([assignedCommercialId, isArchived])
  @@index([relationshipStatus])
}

model ClientDocument {
  id           String             @id @default(cuid())
  clientId     String
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type         ClientDocumentType @default(OTHER)
  title        String?
  fileName     String
  fileUrl      String
  fileMimeType String?
  fileSize     Int?
  notes        String?            @db.Text
  uploadedById String?
  uploadedBy   User?              @relation("ClientDocUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime           @default(now())
}

model ClientInteraction {
  id               String          @id @default(cuid())
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type             InteractionType
  date             DateTime        @default(now())
  employeeId       String?
  employee         User?           @relation("InteractionEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  summary          String          @db.Text
  nextAction       String?
  nextFollowUpDate DateTime?
  createdAt        DateTime        @default(now())
}

model ClientReminder {
  id           String         @id @default(cuid())
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title        String
  description  String?        @db.Text
  dueDate      DateTime
  status       ReminderStatus @default(PENDING)
  assignedToId String?
  assignedTo   User?          @relation("ReminderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
}

// ——— Véhicule ———

// ——— Catalogue véhicules (paramètres) ———

model Brand {
  id        String         @id @default(cuid())
  label     String         @unique
  logo      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  models    VehicleModel[]
  vehicles  Vehicle[]
}

model VehicleModel {
  id        String   @id @default(cuid())
  label     String
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  photo     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicles  Vehicle[]

  @@unique([brandId, label])
}

model Vehicle {
  id                    String            @id @default(cuid())
  internalRef           String            @unique
  brandId               String
  brand                 Brand             @relation(fields: [brandId], references: [id])
  modelId               String
  carModel              VehicleModel      @relation(fields: [modelId], references: [id])
  version               String?
  year                  Int
  firstRegistrationDate DateTime?
  mileage               Int               @default(0)
  fuel                  FuelType?
  transmission          TransmissionType?
  color                 String?
  interiorColor         String?
  fiscalPower           Int?
  engineSize            String?
  vin                   String?           @unique
  plate                 String?           @unique
  matriculeW            String?
  origin                VehicleOrigin
  originCountry         String?
  vehicleCondition      VehicleCondition?
  conditionNotes        String?           @db.Text
  purchasePrice         Decimal           @default(0) @db.Decimal(14, 2)
  extraFeesTotal        Decimal           @default(0) @db.Decimal(14, 2)
  costPrice             Decimal           @default(0) @db.Decimal(14, 2)
  targetSalePrice       Decimal?          @db.Decimal(14, 2)
  finalSalePrice        Decimal?          @db.Decimal(14, 2)
  status                VehicleStatus     @default(IN_STOCK)
  isArchived            Boolean           @default(false)
  depotId               String
  depot                 Depot             @relation(fields: [depotId], references: [id])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  purchase              Purchase?
  sale                  Sale?
  proformas             ProformaInvoice[]
  photos                VehiclePhoto[]
  documents             Document[]
  movements             StockMovement[]
  exitVouchers          ExitVoucher[]
  deliveryNotes         DeliveryNote[]
  deliveryDocuments     DeliveryDocument[]

  @@index([status, depotId])
  @@index([depotId, createdAt])
}

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  path      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ——— Achat ———

model Purchase {
  id                 String                @id @default(cuid())
  reference          String                @unique
  vehicleId          String?               @unique
  vehicle            Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  supplierId         String
  supplier           Supplier              @relation(fields: [supplierId], references: [id])
  invoiceNumber      String?
  purchaseDate       DateTime
  invoiceDate        DateTime?
  purchaseType       PurchaseType          @default(LOCAL)
  currency           Currency              @default(MAD)
  amountHT           Decimal               @default(0) @db.Decimal(14, 2)
  taxAmount          Decimal               @default(0) @db.Decimal(14, 2)
  amountTTC          Decimal               @default(0) @db.Decimal(14, 2)
  discount           Decimal               @default(0) @db.Decimal(14, 2)
  totalPurchasePrice Decimal               @default(0) @db.Decimal(14, 2)
  totalExpenses      Decimal               @default(0) @db.Decimal(14, 2)
