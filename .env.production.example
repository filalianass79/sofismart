# ——— SOFISMART — PRODUCTION ———
# Copier vers .env.production (serveur) ou variables Vercel Production
# NE JAMAIS utiliser la base ou les secrets du staging en production

APP_ENV=production
APP_NAME=SOFISMART
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=SOFISMART

NODE_ENV=production

# URL publique HTTPS
APP_URL="https://www.sofismart.com"
NEXTAUTH_URL="https://www.sofismart.com"

# openssl rand -base64 32 — secret UNIQUE production
AUTH_SECRET=
# NEXTAUTH_SECRET=

# PostgreSQL production (Neon ou serveur dédié) — projet SÉPARÉ du staging
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sofismart?schema=public&sslmode=require"

UPLOAD_STORAGE=local
UPLOAD_DIR="public/uploads"
PDF_STORAGE_PATH="public/uploads"
MAX_UPLOAD_BYTES=10485760

ENABLE_DEBUG_MODE=false
ENABLE_MOCK_NOTIFICATIONS=false

# Premier déploiement uniquement
SEED_MODE=production
SEED_ADMIN_EMAIL=admin@votre-domaine.ma
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrateur SOFISMART

# ——— E-mail production ———
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_TEST_MODE=false
EMAIL_LOG_ONLY=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=SOFISMART
SMTP_FROM_EMAIL=contact@sofismart.ma
SMTP_REPLY_TO=contact@sofismart.ma

RESEND_API_KEY=
EMAIL_SUPPORT_EMAIL=contact@sofismart.ma

# ——— WhatsApp production ———
WHATSAPP_PROVIDER=meta
WHATSAPP_ENABLED=false
WHATSAPP_TEST_MODE=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_DEFAULT_COUNTRY_CODE=212

# S3 pour uploads persistants (recommandé AWS — voir README-AWS-PRODUCTION.md)
UPLOAD_STORAGE=s3
AWS_REGION=eu-west-3
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
# Sur ECS : rôle IAM task (pas de clés). EC2 local : décommenter si besoin.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Docker Compose (option on-premise)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=sofismart
