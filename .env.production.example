# ——— SOFISMART — PRODUCTION AWS LIGHTSAIL ———
# Copier vers .env.production sur le serveur (jamais committer)
# Usage : docker compose --env-file .env.production up -d --build

# ——— Application ———
NODE_ENV=production
APP_ENV=production
APP_NAME=SOFISMART
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_NAME=SOFISMART

APP_URL=https://app.sofismart.com
NEXTAUTH_URL=https://app.sofismart.com
# Alias Auth.js v5 (optionnel, même valeur que NEXTAUTH_URL)
AUTH_URL=https://app.sofismart.com

# openssl rand -base64 32
AUTH_SECRET=ouVBXQG3uFeRuzPknwY18xGgPRpUJsrNCZnHVQOiPfs=
NEXTAUTH_SECRET=ouVBXQG3uFeRuzPknwY18xGgPRpUJsrNCZnHVQOiPfs=

# ——— Base de données (service Docker "db") ———
POSTGRES_USER=sofismart_user
POSTGRES_PASSWORD=bSLVEWXlSSUW7f5IXmOacpZE7bJJ4tXJ
POSTGRES_DB=sofismart
DATABASE_URL=postgresql://sofismart_user:bSLVEWXlSSUW7f5IXmOacpZE7bJJ4tXJ@db:5432/sofismart?schema=public

# ——— Stockage fichiers (volume Docker persistant) ———
UPLOAD_STORAGE=local
UPLOAD_DIR=public/uploads
PDF_STORAGE_PATH=public/uploads/pdfs
MAX_UPLOAD_BYTES=52428800

# ——— Sécurité ———
# openssl rand -hex 32
QR_SECRET=fb28ffa7725cdad30712de68c8e38fb63a227bacae298709a58584ffc3777b1b
ENABLE_DEBUG_MODE=false
ENABLE_MOCK_NOTIFICATIONS=false

# ——— Premier déploiement ———
RUN_MIGRATIONS_ON_START=true
RUN_SEED_ON_START=true
SEED_MODE=production
SEED_ADMIN_EMAIL=admin@sofismart.com
SEED_ADMIN_PASSWORD=SofiAdmin2026!Secure
SEED_ADMIN_NAME=Administrateur SOFISMART

# ——— E-mail ———
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_TEST_MODE=false
EMAIL_LOG_ONLY=false
# Gmail : smtp.gmail.com (PAS smtp.google.com) + mot de passe d'application Google
# AWS SES (recommandé prod) : email-smtp.eu-west-3.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@sofismart.com
SMTP_FROM_NAME=SOFISMART
SMTP_FROM_EMAIL=contact@sofismart.com
SMTP_REPLY_TO=contact@sofismart.com
EMAIL_SUPPORT_EMAIL=contact@sofismart.com

# ——— Import facture OCR + IA ———
AI_EXTRACTION_ENABLED=true
# Provider : openai | claude | gemini
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
# Clé universelle (prioritaire) ou clé par provider :
# AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0
AI_MAX_RUNS_PER_USER_PER_DAY=50

# ——— WhatsApp Meta Cloud API ———
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=meta
WHATSAPP_TEST_MODE=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_DEFAULT_COUNTRY_CODE=212
