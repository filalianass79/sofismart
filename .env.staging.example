# ——— SOFISMART — Environnement TEST / STAGING ———
# Copier vers .env.staging (local) ou configurer dans Vercel (Preview/Staging)

APP_ENV=staging
APP_NAME=SOFISMART TEST
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_NAME=SOFISMART TEST

NODE_ENV=production
# URL Vercel preview ou domaine staging dédié
APP_URL="https://sofismart-staging.vercel.app"
NEXTAUTH_URL="https://sofismart-staging.vercel.app"

# openssl rand -base64 32 — DIFFÉRENT de production
AUTH_SECRET=
# NEXTAUTH_SECRET=  # alias accepté

# ——— Neon PostgreSQL (staging) ———
# Créer une branche / projet Neon séparé de la production
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/sofismart_staging?sslmode=require"

# ——— Stockage ———
# Vercel : filesystem éphémère — uploads non persistants entre déploiements
UPLOAD_STORAGE=local
UPLOAD_DIR="public/uploads"
PDF_STORAGE_PATH="public/uploads"
MAX_UPLOAD_BYTES=10485760

ENABLE_DEBUG_MODE=true
ENABLE_MOCK_NOTIFICATIONS=true

# ——— Seed staging ———
SEED_MODE=staging

# ——— E-mail (simulation) ———
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp
EMAIL_TEST_MODE=true
EMAIL_LOG_ONLY=true
# Si EMAIL_LOG_ONLY=false, rediriger vers :
# EMAIL_TEST_RECIPIENT=votre-email@test.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@test.sofismart.ma
SMTP_FROM_NAME=SOFISMART TEST
SMTP_FROM_EMAIL=contact@test.sofismart.ma

# ——— WhatsApp (simulation uniquement) ———
WHATSAPP_ENABLED=false
WHATSAPP_TEST_MODE=true

# ——— Build / déploiement ———
# Renseigné automatiquement par Vercel :
# VERCEL_GIT_COMMIT_SHA=
# VERCEL_DEPLOYMENT_CREATED_AT=
