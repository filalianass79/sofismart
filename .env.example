# ——— SOFISMART — Environnement local (DEV) ———
# Copier vers .env.local pour le développement

# ——— Environnement ———
APP_ENV=development
APP_NAME=SOFISMART
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=SOFISMART

NODE_ENV=development
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Générer : openssl rand -base64 32
AUTH_SECRET="change-me-minimum-32-characters-long"
# NEXTAUTH_SECRET=  # alias accepté

# ——— Base de données ———
# Docker local (docker-compose.yml) : port hôte 5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sofismart?schema=public"

# ——— Fichiers & PDF ———
UPLOAD_STORAGE=local
UPLOAD_DIR="public/uploads"
PDF_STORAGE_PATH="public/uploads"
MAX_UPLOAD_BYTES=10485760

ENABLE_DEBUG_MODE=true
ENABLE_MOCK_NOTIFICATIONS=false

# ——— Seed ———
# demo | staging | production
SEED_MODE=demo

# ——— E-mail ———
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_TEST_MODE=true
EMAIL_LOG_ONLY=false
# EMAIL_TEST_RECIPIENT=votre-email@test.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=SOFISMART
SMTP_FROM_EMAIL=contact@sofismart.com
SMTP_REPLY_TO=contact@sofismart.com

RESEND_API_KEY=
EMAIL_SUPPORT_EMAIL=contact@sofismart.com

# ——— WhatsApp ———
WHATSAPP_PROVIDER=meta
WHATSAPP_ENABLED=false
WHATSAPP_TEST_MODE=true
WHATSAPP_DEFAULT_COUNTRY_CODE=212

# ——— Import facture OCR + IA ———
AI_EXTRACTION_ENABLED=false
# Provider : openai | claude | gemini
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
# AI_API_KEY=          # universel
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0
AI_MAX_RUNS_PER_USER_PER_DAY=50

# AWS S3 (production future — UPLOAD_STORAGE=s3)
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
